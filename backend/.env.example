# Copy this file to .env and fill in your own values

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
# Where your deployed frontend lives (used for CORS). Comma-separate several origins if needed.
CLIENT_URL=http://localhost:5173

# --- Database (cloud PostgreSQL) -------------------------------------------
# Works with Supabase, Neon, Render Postgres, Railway, AWS RDS ... any Postgres.
# Supabase: Project > Connect > "Session pooler" connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Hosted databases need SSL. Set to "false" only for a local Postgres.
DATABASE_SSL=true

# --- File storage (S3-compatible, PRIVATE bucket) ---------------------------
# Your uploaded documents live here, NOT on the backend server.
# Works with Supabase Storage (S3), Cloudflare R2, AWS S3, Backblaze B2 ...
S3_BUCKET=patrakosh-documents
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=ap-south-1
# Leave S3_ENDPOINT empty for AWS S3. Otherwise set it, e.g.
#   Supabase:      https://<project-ref>.storage.supabase.co/storage/v1/s3
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com   (S3_REGION=auto)
S3_ENDPOINT=

# --- Email (used for the 21-day expiry reminder) ---
# For Gmail: turn on 2FA on the Google account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use that below (not your
# normal Gmail password). You can use any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="PatraKosh <your-email@gmail.com>"

# How many days before expiry to send the warning email
EXPIRY_WARNING_DAYS=21

# How often the cron job checks for expiring documents (standard cron syntax)
CRON_SCHEDULE=0 * * * *

# --- Google sign-in ---
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Add your frontend URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Document PIN ---
# After the right PIN is entered, documents stay unlocked for this many minutes.
PIN_SESSION_MINUTES=5
# Wrong tries allowed before the PIN is locked, and for how long.
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
